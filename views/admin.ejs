<%- include("templates/header") %>

<h1>Admin Page</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>User Type</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        <% users.forEach(user => { %>
            <%- include("templates/user", { user: user }) %>
        <% }) %>
    </tbody>
</table>

<%- include("templates/footer") %>